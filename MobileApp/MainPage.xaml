<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MobileApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        BackgroundColor="AliceBlue"
        ColumnDefinitions="*,*"
        RowDefinitions="*,*,*,*">
        <Button
            x:Name="ColorMakerButton"
            Grid.Row="0"
            Grid.Column="0"
            Margin="20"
            BackgroundColor="LightCoral"
            Clicked="ColorMakerButton_Clicked"
            FontSize="20"
            Text="Color Maker"
            TextColor="White" />
        <Button
            x:Name="PerfectShareButton"
            Grid.Row="0"
            Grid.Column="1"
            Margin="20"
            BackgroundColor="LightCoral"
            Clicked="PerfectShareButton_Clicked"
            FontSize="20"
            Text="Perfect Share"
            TextColor="White" />
        <Button
            x:Name="CodeQuotesButton"
            Grid.Row="1"
            Grid.Column="0"
            Margin="20"
            BackgroundColor="LightCoral"
            Clicked="CodeQuotesButton_Clicked"
            FontSize="20"
            Text="Code Quotes"
            TextColor="White" />


    </Grid>

</ContentPage>
